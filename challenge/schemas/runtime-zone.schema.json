{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenops.invalid/specs/runtime-zone.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "slug": {
      "$ref": "https://greenops.invalid/specs/common.schema.json#/$defs/zone"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "electricity_area": {
      "type": "string",
      "minLength": 1
    },
    "eu_member": {
      "type": "boolean"
    },
    "pue": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(\\.[0-9]{1,6})?$"
    },
    "pue_provenance": {
      "const": "fictional_game_value"
    },
    "fictional": {
      "type": "boolean"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "city": {
          "type": "string",
          "minLength": 1
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "precision": {
          "const": "city"
        }
      },
      "required": [
        "city",
        "latitude",
        "longitude",
        "precision"
      ]
    }
  },
  "required": [
    "slug",
    "name",
    "country",
    "electricity_area",
    "eu_member",
    "pue",
    "pue_provenance",
    "fictional",
    "location"
  ]
}
