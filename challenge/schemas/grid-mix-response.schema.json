{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenops.invalid/specs/grid-mix-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "zone": {
      "enum": [
        "AT",
        "BG",
        "CH",
        "DE",
        "HR",
        "ES",
        "IT",
        "FR"
      ]
    },
    "temporalGranularity": {
      "const": "hourly"
    },
    "unit": {
      "const": "MW"
    },
    "provenance": {
      "const": "fictional"
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "datetime": {
            "$ref": "https://greenops.invalid/specs/common.schema.json#/$defs/utc"
          },
          "updatedAt": {
            "$ref": "https://greenops.invalid/specs/common.schema.json#/$defs/utc"
          },
          "breakdownType": {
            "const": "normal"
          },
          "mix": {
            "$ref": "https://greenops.invalid/specs/electricity.schema.json#/$defs/mix"
          },
          "isEstimated": {
            "const": true
          },
          "estimationMethod": {
            "type": "string"
          }
        },
        "required": [
          "datetime",
          "updatedAt",
          "breakdownType",
          "mix",
          "isEstimated",
          "estimationMethod"
        ]
      }
    },
    "history": {
      "type": "array",
      "minItems": 24,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "datetime": {
            "$ref": "https://greenops.invalid/specs/common.schema.json#/$defs/utc"
          },
          "updatedAt": {
            "$ref": "https://greenops.invalid/specs/common.schema.json#/$defs/utc"
          },
          "breakdownType": {
            "const": "normal"
          },
          "mix": {
            "$ref": "https://greenops.invalid/specs/electricity.schema.json#/$defs/mix"
          },
          "isEstimated": {
            "const": true
          },
          "estimationMethod": {
            "type": "string"
          }
        },
        "required": [
          "datetime",
          "updatedAt",
          "breakdownType",
          "mix",
          "isEstimated",
          "estimationMethod"
        ]
      }
    }
  },
  "required": [
    "zone",
    "temporalGranularity",
    "unit",
    "provenance"
  ],
  "oneOf": [
    {
      "required": [
        "data"
      ]
    },
    {
      "required": [
        "history"
      ]
    }
  ]
}
